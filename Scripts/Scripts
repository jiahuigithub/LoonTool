[MITM]

hostname =in.m.jd.com

[Script]
# 京东比价 hostname = in.m.jd.com 原始，表格，折线不能同时开启, 点击商品详情页触发脚本
# http-response ^https:\/\/in\.m\.jd\.com\/product\/graphext\/\d+\.html script-path=https://kelee.one/Resource/Script/JD/JD_Price.js, requires-body=true, timeout=10, tag=京东比价
response if ${url} ~= /^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=(wareBusiness|serverConfig|basicConfig)/i then script("https://raw.githubusercontent.com/wf021325/qx/master/js/jd_price.js") with enable=false, tag="[京东比价]标题嵌入版", requires_body=true
request if ${url} ~= /^https?:\/\/in\.m\.jd\.com\/product\/graphext\/\d+\.html/i then script("https://raw.githubusercontent.com/mw418/Loon/main/script/jd_price.js") with enable=false, tag="[京东比价]详情通知版", timeout=60
response if ${url} ~= /^https?:\/\/in\.m\.jd\.com\/product\/graphext\/\d+\.html/i then script("https://raw.githubusercontent.com/wf021325/qx/master/js/jd_price.js") with tag="[京东比价]详情嵌入版（表格图）", timeout=60, requires_body=true
response if ${url} ~= /^https?:\/\/in\.m\.jd\.com\/product\/graphext\/\d+\.html/i then script("https://loon.103516.xyz/Script/Jingdong/JD_Price.js") with enable=false, tag="[京东比价]详情嵌入版（折线图）", timeout=60, requires_body=true

# 淘宝比价 hostname =trade-acs.m.taobao.com
# http-request ^http://.+/amdc/mobileDispatch script-path=https://service.2ti.st/QuanX/Script/jd_tb_price/main.js, requires-body=true, timeout=60, tag=淘宝比价
# http-response ^http://.+/amdc/mobileDispatch script-path=https://service.2ti.st/QuanX/Script/jd_tb_price/main.js, requires-body=true, timeout=60, tag=淘宝比价
# http-response ^https?://trade-acs\.m\.taobao\.com/gw/mtop\.taobao\.detail\.data\.get script-path=https://service.2ti.st/QuanX/Script/jd_tb_price/main.js, requires-body=true, timeout=60, tag=淘宝比价

